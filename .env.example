PATH_TO_SERVER_ROOT=../../

GIT_SERVER_SCKT=<...>
GIT_SERVER_MYSQL_SCKT=<...>

GIT_SERVER_SITE_DOMAIN=git.anonymousrand.xyz

GIT_SERVER_MYSQL_DB_NAME=git_server
GIT_SERVER_MYSQL_ROOT_PASSWORD=solarwinds123
GIT_SERVER_MYSQL_USERNAME=anonymousrand
GIT_SERVER_MYSQL_PASSWORD=solarwinds123

# SYNC: with forgejo's default config file location inside `FORGEJO_CUSTOM_DEST_DIR`
GIT_SERVER_CONFIG_DEST_FILE=/custom/conf/app.ini
GIT_SERVER_DATA_DEST_DIR=/data/
# we don't use `/data/...` since forgejo writes stuff in there itself
FORGEJO_CUSTOM_SRC_DIR=./data/custom/
FORGEJO_CUSTOM_DEST_DIR=/custom/

# i think the default 22 is weirdly broken in the container as there is already an `sshd` on there?
FORGEJO_SSH_PORT=<...>
# extremely important to keep `FORGEJO_SECRET_KEY` consistent for e.g. mfa!!
FORGEJO_SECRET_KEY=<run `forgejo generate secret SECRET_KEY`>
FORGEJO_INTERNAL_TOKEN=<run `forgejo generate secret INTERNAL_TOKEN`>
FORGEJO_JWT_SECRET=<run `forgejo generate secret JWT_SECRET`>

FORGEJO_SHARED_SECRET=<run `openssl rand -hex 20`>
FORGEJO_UUID=<run `echo -n "$FORGEJO_SHARED_SECRET" | python -c 'import sys; import uuid;input=sys.stdin.read();print(str(uuid.UUID(bytes=input[:16].encode("utf-8"))))'`>
FORGEJO_RUNNER_DIND_HOSTNAME=
FORGEJO_RUNNER_CERTS_DEST_DIR=/certs/
# SYNC: make sure this is inside `FORGEJO_RUNNER_CERTS_DEST_DIR` so they can use the same volume
FORGEJO_RUNNER_CLIENT_CERTS_DEST_DIR=/certs/client/
FORGEJO_RUNNER_CONFIG_SRC_DIR=./data/forgejo_runner/
FORGEJO_RUNNER_CONFIG_DEST_DIR=/custom/
# SYNC: make sure this is inside `FORGEJO_RUNNER_CONFIG_DEST_DIR`
FORGEJO_RUNNER_CONFIG_DEST_FILE=/custom/config.yaml
# SYNC: paths in which container produces data
FORGEJO_RUNNER_DATA_DEST_DIR=/data/
